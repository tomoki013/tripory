    "海外旅行の記録から、住んでいる国を除くために使います。設定した国は自動的に「訪問済み」になり、行き先の候補からは外れます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم لاستبعاد دولة إقامتك من رحلاتك الخارجية. تُوسَم الدولة المحدّدة تلقائياً بأنها «تمت زيارتها» وتُزال من اقتراحات الوجهات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží k vyloučení země pobytu z cest do zahraničí. Nastavená země se automaticky označí jako „Navštíveno“ a zmizí z nabídky destinací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at udelade dit hjemland fra dine udlandsrejser. Landet, du vælger, markeres automatisk som “Besøgt” og fjernes fra rejsemålsforslagene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird dein Heimatland aus deinen Auslandsreisen ausgeschlossen. Das festgelegte Land gilt automatisch als „Besucht“ und erscheint nicht mehr unter den Reisezielen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμεύει για να εξαιρεθεί η χώρα διαμονής από τα ταξίδια στο εξωτερικό. Η χώρα που ορίζεις σημειώνεται αυτόματα ως «Επισκέφθηκα» και βγαίνει από τους προτεινόμενους προορισμούς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to exclude your home country from your overseas trip records. The country you set is automatically marked \"Visited\" and removed from destination candidates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para excluir tu país de residencia de tus registros de viajes al extranjero. El país que configures se marcará automáticamente como \"Visitado\" y se eliminará de los destinos candidatos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään jättämään kotimaasi pois ulkomaanmatkoista. Valitsemasi maa merkitään automaattisesti ”Vierailtu” ja poistuu kohde-ehdotuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à exclure votre pays de résidence de vos voyages à l'étranger enregistrés. Le pays défini est automatiquement marqué « Visité » et retiré des destinations possibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמש כדי להוציא את מדינת המגורים שלך מנסיעות לחו״ל. המדינה שתגדיר תסומן אוטומטית כ«ביקרת» ותוסר מהצעות היעדים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके निवास देश को विदेश यात्राओं से बाहर रखने के लिए है। तय किया देश स्वतः \"देखा गया\" हो जाता है और गंतव्य सुझावों से हट जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arra szolgál, hogy kizárja a lakóhelyed országát a külföldi utazásaidból. A beállított ország automatikusan „Meglátogatott” lesz, és kikerül az úti cél javaslatok közül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipakai untuk mengecualikan negara tempat tinggalmu dari perjalanan luar negeri. Negara yang diatur otomatis ditandai \"Dikunjungi\" dan keluar dari saran tujuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve a escludere il tuo paese di residenza dai viaggi all’estero. Il paese impostato risulta automaticamente «Visitato» ed esce dalle mete proposte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海外旅行の記録から、住んでいる国を除くために使います。設定した国は自動的に「訪問済み」になり、行き先の候補からは外れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해외 여행 기록에서 거주 국가를 제외하기 위해 사용합니다. 설정한 국가는 자동으로 '방문함'으로 표시되며 여행지 후보에서 제외됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk mengecualikan negara kediaman anda daripada pengembaraan luar negara. Negara yang ditetapkan akan ditanda \"Dilawati\" secara automatik dan dikeluarkan daripada cadangan destinasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å utelate hjemlandet ditt fra utenlandsreisene. Landet du velger merkes automatisk som «Besøkt» og fjernes fra reisemålsforslagene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee sluit je je thuisland uit van je buitenlandse reizen. Het ingestelde land geldt automatisch als ‘Bezocht’ en verdwijnt uit de bestemmingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do wyłączenia kraju zamieszkania z podróży zagranicznych. Wybrany kraj automatycznie otrzymuje status „Odwiedzone” i znika z propozycji celów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve para excluir seu país de residência dos registros de viagens ao exterior. O país definido fica automaticamente como “Visitado” e sai das sugestões de destino."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servește la excluderea țării de reședință din călătoriile în străinătate. Țara setată devine automat „Vizitat” și iese din sugestiile de destinație."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна, чтобы исключить страну проживания из зарубежных поездок. Выбранная страна автоматически отмечается как «Посещено» и убирается из вариантов направлений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att utesluta ditt hemland från dina utlandsresor. Landet du anger markeras automatiskt som ”Besökt” och tas bort från resmålsförslagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อยกเว้นประเทศที่พำนักออกจากบันทึกการเดินทางต่างประเทศ ประเทศที่ตั้งไว้จะถูกทำเครื่องหมาย \"เยือนแล้ว\" โดยอัตโนมัติ และถูกนำออกจากรายการจุดหมายที่แนะนำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşadığın ülkeyi yurt dışı seyahatlerinden hariç tutmak için kullanılır. Ayarladığın ülke otomatik olarak “Ziyaret edildi” olur ve hedef önerilerinden çıkar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібна, щоб виключити країну проживання із закордонних подорожей. Вибрана країна автоматично позначається як «Відвідано» і зникає з варіантів напрямків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để loại quốc gia cư trú khỏi các chuyến đi nước ngoài. Quốc gia bạn đặt sẽ tự động được đánh dấu \"Đã ghé\" và bị loại khỏi gợi ý điểm đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于将居住国家从海外旅行记录中排除。设置的国家会自动标记为“已访问”,并从目的地候选中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用來從海外旅行記錄中排除你的居住國家。所設定的國家會自動標為「已造訪」，並從目的地建議中移除。"
          }
        }
      }
    },
    "海外旅行の記録から、住んでいる国を除くために使います。過去に設定していた国は「旅の記録」ページで確認できます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
