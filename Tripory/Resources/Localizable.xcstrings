            "value" : "अपना संग्रह शुरू करने के लिए एक यात्रा दर्ज करें या इच्छित देश जोड़ें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzíts egy utazást, vagy adj hozzá egy kívánságországot a gyűjteményed indításához."
          }
        },
        "id" : {
          "stringUnit" : {
