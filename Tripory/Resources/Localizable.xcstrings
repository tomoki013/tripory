    "最初の旅を残すと、訪れた国と写真があなたの世界に加わります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل رحلتك الأولى لتُضاف دولها وصورها إلى عالمك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenejte první cestu a její země i fotky se přidají do vašeho světa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem din første rejse, så føjes dens lande og billeder til din verden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichne deine erste Reise auf, um ihre Länder und Fotos zu deiner Welt hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατάγραψε το πρώτο σου ταξίδι για να προστεθούν οι χώρες και οι φωτογραφίες του στον κόσμο σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record your first trip to add its countries and photos to your world."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra tu primer viaje para añadir sus países y fotos a tu mundo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna ensimmäinen matkasi, niin sen maat ja kuvat liittyvät maailmaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez votre premier voyage pour ajouter ses pays et ses photos à votre monde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תעד את המסע הראשון שלך כדי להוסיף את מדינותיו ותמונותיו לעולם שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी पहली यात्रा दर्ज करें ताकि उसके देश और तस्वीरें आपकी दुनिया में जुड़ें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzítsd az első utazásodat, hogy országai és fotói a világodhoz kerüljenek."
