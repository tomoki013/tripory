        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потрібна, щоб виключити країну проживання із закордонних подорожей. Раніше вибрані країни видно на сторінці «Подорожі»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để loại quốc gia cư trú khỏi các chuyến đi nước ngoài. Các quốc gia đã đặt trước đây có thể xem trên trang Chuyến đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
