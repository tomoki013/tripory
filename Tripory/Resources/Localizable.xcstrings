    "旅を記録するか、行きたい国を追加するとここに並びます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل رحلة أو أضف دولة ترغب بزيارتها لتبدأ مجموعتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznamenejte cestu nebo přidejte vysněnou zemi a začněte sbírku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem en rejse eller tilføj et ønskeland for at starte din samling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichne eine Reise auf oder füge ein Wunschland hinzu, um deine Sammlung zu starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατάγραψε ένα ταξίδι ή πρόσθεσε μια χώρα που θες να δεις για να ξεκινήσεις τη συλλογή σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record a trip or add a wishlist country to start your collection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un viaje o añade un país que quieras visitar para empezar tu colección."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
