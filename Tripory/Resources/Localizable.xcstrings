    "ここから、あなたの世界が育っていきます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من هنا سيكبر عالمك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtud začne váš svět růst."
          }
        },
