        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 여행을 기록하면 방문한 나라와 사진이 당신의 세계에 더해집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
