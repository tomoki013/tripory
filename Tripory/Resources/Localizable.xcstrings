    "表紙の写真を選ばない場合は、最初の訪問先の写真が自動で使われます": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't choose a cover photo, the first destination's photo is used automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no eliges una foto de portada, se usará automáticamente la foto del primer destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ne choisissez pas de photo de couverture, la photo de la première destination sera utilisée automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表紙の写真を選ばない場合は、最初の訪問先の写真が自動で使われます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표지 사진을 선택하지 않으면 첫 번째 방문지의 사진이 자동으로 사용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
