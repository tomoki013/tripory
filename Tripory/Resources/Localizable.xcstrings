    },
    "旅を記録するたび、\n行った国と思い出が\nあなたの世界になる。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل رحلة تسجّلها\nتحوّل الدول والذكريات\nإلى عالمك الخاص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá zaznamenaná cesta\nmění země a vzpomínky\nve váš vlastní svět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver rejse du gemmer\ngør lande og minder\ntil din egen verden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Reise, die du aufzeichnest,\nmacht Länder und Erinnerungen\nzu deiner eigenen Welt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε ταξίδι που καταγράφεις\nκάνει χώρες και αναμνήσεις\nτον δικό σου κόσμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every trip you record\nturns countries and memories\ninto your own world."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada viaje que registras\nconvierte países y recuerdos\nen tu propio mundo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen tallentamasi matka\ntekee maista ja muistoista\noman maailmasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque voyage enregistré\ntransforme pays et souvenirs\nen votre propre monde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל מסע שאתה מתעד\nהופך מדינות וזיכרונות\nלעולם משלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दर्ज यात्रा\nदेशों और यादों को\nआपकी अपनी दुनिया बनाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden rögzített utazás\nországokat és emlékeket\nvarázsol a saját világoddá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap perjalanan yang kamu catat\nmengubah negara dan kenangan\nmenjadi duniamu sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni viaggio che registri\ntrasforma paesi e ricordi\nnel tuo mondo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행을 기록할 때마다\n다녀온 나라와 추억이\n당신의 세계가 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap pengembaraan yang direkod\nmengubah negara dan kenangan\nmenjadi dunia anda sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver reise du lagrer\ngjør land og minner\ntil din egen verden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke reis die je vastlegt\nmaakt landen en herinneringen\ntot jouw eigen wereld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda zapisana podróż\nzmienia kraje i wspomnienia\nw twój własny świat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada viagem que você registra\ntransforma países e lembranças\nno seu próprio mundo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare călătorie înregistrată\ntransformă țări și amintiri\nîn propria ta lume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая записанная поездка\nпревращает страны и воспоминания\nв ваш собственный мир."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje resa du sparar\ngör länder och minnen\ntill din egen värld."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกการเดินทางที่คุณบันทึก\nจะเปลี่ยนประเทศและความทรงจำ\nให้เป็นโลกของคุณเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydettiğin her seyahat\nülkeleri ve anıları\nsenin dünyana dönüştürür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожна записана подорож\nперетворює країни та спогади\nна ваш власний світ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi chuyến đi bạn ghi lại\nbiến quốc gia và kỷ niệm\nthành thế giới của riêng bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每记录一次旅行，\n去过的国家与回忆\n就成为你的世界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每記錄一趟旅程，\n去過的國家與回憶\n就成為你的世界。"
          }
        }
      }
    },
    "旅を記録するたび、\n訪れた国と思い出が、\nあなたの世界になっていく。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في كل مرة تسجّل فيها رحلة،\nتتحول الدول والذكريات التي جمعتها\nإلى عالمك الخاص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaždé, když zaznamenáte cestu,\nse navštívené země a vzpomínky\nstávají vaším světem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang du registrerer en rejse,\nbliver de lande og minder, du har samlet,\ntil din verden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Mal, wenn du eine Reise festhältst,\nwerden die Länder und Erinnerungen, die du sammelst,\nzu deiner Welt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε φορά που καταγράφεις ένα ταξίδι,\nοι χώρες και οι αναμνήσεις που συγκεντρώνεις\nγίνονται ο κόσμος σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every time you record a trip,\nthe countries and memories you've gathered\nbecome your world."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que registras un viaje,\nlos países y recuerdos que reúnes\nse convierten en tu mundo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aina kun tallennat matkan,\nkeräämistäsi maista ja muistoista\ntulee sinun maailmasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fois que vous enregistrez un voyage,\nles pays et les souvenirs que vous rassemblez\ndeviennent votre monde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בכל פעם שאתם מתעדים טיול,\nהמדינות והזיכרונות שאספתם\nהופכים לעולם שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब भी आप कोई यात्रा दर्ज करते हैं,\nजो देश और यादें आपने जुटाई हैं,\nवे आपकी दुनिया बन जाती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden alkalommal, amikor rögzítesz egy utazást,\naz összegyűjtött országok és emlékek\na te világoddá válnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap kali Anda mencatat sebuah perjalanan,\nnegara dan kenangan yang telah Anda kumpulkan\nmenjadi dunia Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni volta che registri un viaggio,\ni paesi e i ricordi che raccogli\ndiventano il tuo mondo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행을 기록할 때마다\n모아온 나라와 추억들이\n당신의 세계가 되어갑니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap kali anda merekod perjalanan,\nnegara dan kenangan yang anda kumpulkan\nmenjadi dunia anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gang du registrerer en reise,\nblir landene og minnene du samler,\ntil din verden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke keer dat je een reis vastlegt,\nworden de landen en herinneringen die je verzamelt\njouw wereld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za każdym razem, gdy zapisujesz podróż,\nkraje i wspomnienia, które gromadzisz,\nstają się twoim światem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda vez que você registra uma viagem,\nos países e memórias que você reúne\nse tornam o seu mundo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fiecare dată când înregistrezi o călătorie,\nțările și amintirile pe care le aduni\ndevin lumea ta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый раз, когда вы записываете поездку,\nстраны и воспоминания, которые вы собираете,\nстановятся вашим миром."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje gång du registrerar en resa\nblir länderna och minnena du samlar\ntill din värld."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกครั้งที่คุณบันทึกการเดินทาง\nประเทศและความทรงจำที่คุณสะสมไว้\nจะกลายเป็นโลกของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her seyahat kaydettiğinde,\ntopladığın ülkeler ve anılar\nsenin dünyan haline gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоразу, коли ви записуєте подорож,\nкраїни та спогади, які ви зібрали,\nстають вашим світом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi khi bạn ghi lại một chuyến đi,\nnhững quốc gia và kỷ niệm bạn góp nhặt\nsẽ trở thành thế giới của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次记录旅行,\n收集到的国家与回忆,\n都会变成属于你的世界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次記錄旅行,\n收集到的國家與回憶,\n都會變成屬於你的世界。"
          }
        }
      }
    },
