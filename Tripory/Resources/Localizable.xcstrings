            "value" : "يُستخدم لاستبعاد دولة إقامتك من رحلاتك الخارجية. الدول التي سبق ضبطها يمكن استعراضها في صفحة الرحلات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží k vyloučení země pobytu z cest do zahraničí. Dříve nastavené země najdete na stránce Cesty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at udelade dit hjemland fra dine udlandsrejser. Tidligere valgte lande finder du på Rejser-siden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird dein Heimatland aus deinen Auslandsreisen ausgeschlossen. Früher festgelegte Länder findest du auf der Reisen-Seite."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμεύει για να εξαιρεθεί η χώρα διαμονής από τα ταξίδια στο εξωτερικό. Τις χώρες που είχες ορίσει παλιότερα τις βρίσκεις στη σελίδα Ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to exclude your home country from your overseas trip records. Previously set countries can be viewed on the Trips page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para excluir tu país de residencia de tus registros de viajes al extranjero. Los países configurados anteriormente se pueden consultar en la página de Viajes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään jättämään kotimaasi pois ulkomaanmatkoista. Aiemmin valitut maat löydät Matkat-sivulta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à exclure votre pays de résidence de vos voyages à l'étranger enregistrés. Les pays définis précédemment sont consultables sur la page Voyages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמש כדי להוציא את מדינת המגורים שלך מנסיעות לחו״ל. מדינות שהוגדרו בעבר אפשר לראות בעמוד המסעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके निवास देश को विदेश यात्राओं से बाहर रखने के लिए है। पहले तय किए देश यात्रा पृष्ठ पर देखे जा सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arra szolgál, hogy kizárja a lakóhelyed országát a külföldi utazásaidból. A korábban beállított országokat az Utazások oldalon találod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipakai untuk mengecualikan negara tempat tinggalmu dari perjalanan luar negeri. Negara yang pernah diatur bisa dilihat di halaman Perjalanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve a escludere il tuo paese di residenza dai viaggi all’estero. I paesi impostati in passato si trovano nella pagina Viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海外旅行の記録から、住んでいる国を除くために使います。過去に設定していた国は「旅の記録」ページで確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해외 여행 기록에서 거주 국가를 제외하기 위해 사용합니다. 이전에 설정했던 국가는 '여행 기록' 페이지에서 확인할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk mengecualikan negara kediaman anda daripada pengembaraan luar negara. Negara yang pernah ditetapkan boleh dilihat pada halaman Pengembaraan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å utelate hjemlandet ditt fra utenlandsreisene. Tidligere valgte land finner du på Reiser-siden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee sluit je je thuisland uit van je buitenlandse reizen. Eerder ingestelde landen vind je op de pagina Reizen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do wyłączenia kraju zamieszkania z podróży zagranicznych. Wcześniej ustawione kraje znajdziesz na stronie Podróże."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve para excluir seu país de residência dos registros de viagens ao exterior. Os países definidos antes aparecem na página Viagens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servește la excluderea țării de reședință din călătoriile în străinătate. Țările setate anterior le găsești pe pagina Călătorii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна, чтобы исключить страну проживания из зарубежных поездок. Ранее выбранные страны видны на странице «Поездки»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att utesluta ditt hemland från dina utlandsresor. Tidigare inställda länder hittar du på Resor-sidan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เพื่อยกเว้นประเทศที่พำนักออกจากบันทึกการเดินทางต่างประเทศ ประเทศที่เคยตั้งไว้ดูได้ในหน้าการเดินทาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşadığın ülkeyi yurt dışı seyahatlerinden hariç tutmak için kullanılır. Daha önce ayarladığın ülkeleri Seyahatler sayfasında görebilirsin."
