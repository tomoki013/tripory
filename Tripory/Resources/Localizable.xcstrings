    "訪問順や日付は、保存後もいつでも編集できます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تعديل ترتيب الزيارات والتواريخ في أي وقت بعد الحفظ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pořadí návštěv a data můžete po uložení kdykoli upravit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rækkefølgen og datoerne for besøgene kan ændres når som helst efter du har gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihenfolge und Daten der Besuche kannst du nach dem Speichern jederzeit ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σειρά των επισκέψεων και οι ημερομηνίες αλλάζουν όποτε θες μετά την αποθήκευση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can edit the visit order and dates anytime after saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes editar el orden de las visitas y las fechas cuando quieras tras guardar."
