    "自動的に「訪問済み」に切り替わり、行きたい国の一覧からは外れます。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحوّل تلقائياً إلى «تمت زيارتها» ويختفي من قائمة رغباتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky se změní na „Navštíveno“ a zmizí ze seznamu přání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det skifter automatisk til “Besøgt” og forsvinder fra din ønskeliste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wechselt automatisch zu „Besucht“ und verschwindet aus deiner Wunschliste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αλλάζει αυτόματα σε «Επισκέφθηκα» και βγαίνει από τη λίστα επιθυμιών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It automatically switches to \"Visited\" and is removed from your Want to Go list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia automáticamente a \"Visitado\" y se elimina de tu lista de países por visitar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vaihtuu automaattisesti tilaan ”Vierailtu” ja poistuu toivelistaltasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il passe automatiquement à « Visité » et est retiré de votre liste d'envies."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוא עובר אוטומטית ל«ביקרת» ונעלם מרשימת המשאלות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्वतः \"देखा गया\" में बदल जाता है और आपकी इच्छा-सूची से हट जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikusan „Meglátogatott”-ra vált, és kikerül a kívánságlistádról."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatis berubah menjadi \"Dikunjungi\" dan hilang dari daftar keinginanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa automaticamente a «Visitato» ed esce dalla lista dei desideri."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동으로 \"방문함\"으로 전환되며, 가고 싶은 목록에서 제외됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia bertukar secara automatik kepada \"Dilawati\" dan hilang daripada senarai idaman anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det bytter automatisk til «Besøkt» og forsvinner fra ønskelisten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het schakelt automatisch naar ‘Bezocht’ en verdwijnt uit je wenslijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie zmieni się na „Odwiedzone” i zniknie z listy życzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele muda automaticamente para “Visitado” e sai da sua lista de desejos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trece automat pe „Vizitat” și iese din lista ta de dorințe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
