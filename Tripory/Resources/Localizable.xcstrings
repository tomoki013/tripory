    "写真はお使いの端末にのみ保存され、どこにも送信されません" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصور تُخزَّن فقط على جهازك ولا تُرسَل إلى أي مكان"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotky se ukládají pouze do vašeho zařízení a nikam se neodesílají"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos gemmes kun på din enhed og sendes ingen steder hen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos werden nur auf deinem Gerät gespeichert und niemals gesendet"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες αποθηκεύονται μόνο στη συσκευή σας και δεν αποστέλλονται πουθενά"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are stored only on your device and are never sent anywhere"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se guardan solo en tu dispositivo y no se envían a ningún sitio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuvat tallennetaan vain laitteellesi, eikä niitä lähetetä minnekään"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont stockées uniquement sur votre appareil et ne sont jamais envoyées"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמונות נשמרות רק במכשיר שלך ולעולם לא נשלחות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो केवल आपके डिवाइस में सेव होती हैं और कहीं नहीं भेजी जातीं"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fényképek csak a készülékeden tárolódnak, sehova sem kerülnek elküldésre"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto hanya disimpan di perangkatmu dan tidak pernah dikirim ke mana pun"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto vengono salvate solo sul tuo dispositivo e non vengono mai inviate altrove"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진은 기기에만 저장되며 어디로도 전송되지 않습니다"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto hanya disimpan pada peranti anda dan tidak pernah dihantar ke mana-mana"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder lagres bare på enheten din og sendes aldri noe sted"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto's worden alleen op je apparaat opgeslagen en nooit ergens naartoe verzonden"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia są przechowywane wyłącznie na Twoim urządzeniu i nigdzie nie są wysyłane"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos ficam salvas apenas no seu aparelho e nunca são enviadas a lugar nenhum"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiile sunt stocate doar pe dispozitivul tău și nu sunt trimise niciodată nicăieri"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотографии хранятся только на вашем устройстве и никуда не отправляются"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foton sparas bara på din enhet och skickas aldrig någonstans"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปภาพจะถูกเก็บไว้ในอุปกรณ์ของคุณเท่านั้น และจะไม่ถูกส่งไปที่ใดเลย"
