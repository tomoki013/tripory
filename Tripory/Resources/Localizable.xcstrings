    "この写真がホームの主役になります。後からいつでも変更できます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستكون هذه الصورة بطلة الشاشة الرئيسية. يمكنك تغييرها في أي وقت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato fotka bude hlavní na domovské obrazovce. Kdykoli ji můžete změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette billede er i centrum på startsiden. Du kan skifte det når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Foto steht auf der Startseite im Mittelpunkt. Du kannst es jederzeit ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η φωτογραφία θα είναι στο επίκεντρο της αρχικής. Μπορείς να την αλλάξεις όποτε θες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This photo will take center stage on Home. You can change it anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta foto será la protagonista de Inicio. Puedes cambiarla cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kuva on etusivun pääosassa. Voit vaihtaa sen milloin tahansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette photo sera la vedette de l’accueil. Vous pourrez la changer à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התמונה הזו תהיה במרכז מסך הבית. אפשר להחליף אותה בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह तस्वीर होम की मुख्य होगी। आप इसे कभी भी बदल सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a fotó lesz a kezdőképernyő főszereplője. Bármikor megváltoztathatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto ini akan menjadi bintang di layar utama. Kamu bisa menggantinya kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa foto sarà la protagonista della Home. Puoi cambiarla quando vuoi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진이 홈의 주인공이 됩니다. 나중에 언제든 바꿀 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
