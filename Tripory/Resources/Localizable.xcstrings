          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt lagres på enheten din. Ingenting sendes til eksterne servere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles wordt op je apparaat bewaard. Er wordt niets naar externe servers gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
